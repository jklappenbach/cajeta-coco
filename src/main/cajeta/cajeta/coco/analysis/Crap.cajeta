package cajeta.coco.analysis;

import cajeta.coco.model.HitProfile;
import cajeta.coco.model.Site;
import cajeta.coco.model.SiteKind;
import cajeta.coco.util.IntList;
import cajeta.coco.util.Text;
import cajeta.collection.ArrayList;
import cajeta.lang.String;
import cajeta.lang.StringBuilder;

/**
 * CRAP scoring — Change Risk Anti-Patterns (Savoia & Copeland).
 *
 *     CRAP(m) = comp(m)^2 * (1 - cov(m))^3 + comp(m)
 *
 * The score exists to answer "where do I start?" — a plain coverage list
 * ranks a trivial getter and a 40-branch parser as equal work, which is why
 * coverage reports read like chores. Weighting the gap by complexity squared
 * turns the same data into a priority queue: complex-and-untested rises to
 * the top, simple-and-untested sinks, complex-but-tested is fine. The
 * conventional threshold is 30.
 *
 * Inputs are all in hand already:
 *   - comp — cyclomatic complexity ≈ 1 + decisions. Each source decision
 *     produced exactly one instrumented branch-arm PAIR, so
 *     comp = 1 + branchSites/2. Compiler guard branches were excluded at
 *     instrumentation time, so they don't inflate anyone's complexity.
 *   - cov — the method's line coverage, from its own probes.
 *
 * Scores are computed in tenths with int64 arithmetic (the tool's reports are
 * diffed in CI; float formatting drift would show up as phantom changes).
 * cov is per-mille, so (1000-cov)^3 ≤ 1e9 and comp^2 ≤ ~1e4 stay well inside
 * int64.
 */
public class Crap {
    /** Parallel rows, sorted descending by score after `rank`. */
    ArrayList<String> methods;
    IntList complexity;
    IntList covPerMille;
    IntList scoreTenths;

    Crap(int32 cap) {
        this.methods #= heap ArrayList<String>();
        this.complexity #= heap IntList(cap);
        this.covPerMille #= heap IntList(cap);
        this.scoreTenths #= heap IntList(cap);
    }

    public int32 count() { return this.methods.count(); }
    public String methodAt(int32 i) { return this.methods.get(i); }
    public int64 complexityAt(int32 i) { return this.complexity.get(i); }
    public int64 scoreTenthsAt(int32 i) { return this.scoreTenths.get(i); }

    /** Line-coverage percent (integer) for row `i`. */
    public int64 covPercentAt(int32 i) { return this.covPerMille.get(i) / 10; }

    /** Render row `i`'s score as `12.3`. */
    public #String scoreAt(int32 i) {
        int64 t = this.scoreTenths.get(i);
        StringBuilder sb = stack StringBuilder();
        sb.append(Text.fromInt(t / 10));
        sb.append(".");
        sb.append(Text.fromInt(t % 10));
        return sb.toString();
    }

    /**
     * Score every instrumented method, ranked worst-first.
     *
     * Grouping walks the site table once per distinct method — quadratic in
     * methods, linear in probes, both small.
     */
    public static #Crap rank(ArrayList<Site> sites, HitProfile profile) {
        // Distinct methods, in first-seen order (FUNCTION sites only — one
        // per real method; synthesized functions carry no FUNCTION probe).
        ArrayList<String> names #= heap ArrayList<String>();
        int32 i = 0;
        while (i < sites.count()) {
            Site s = sites.get(i);
            if (s.getKind() == SiteKind.FUNCTION) {
                names.add(s.qualified());
            }
            i = i + 1;
        }

        Crap out #= heap Crap(names.count());
        int32 m = 0;
        while (m < names.count()) {
            String name = names.get(m);

            int64 branchArms = 0;
            // Per-line fold (any probe hit -> line hit), same rule as the
            // coverage summary so the two never disagree about a method.
            IntList lineNos #= heap IntList(sites.count());
            IntList lineHit #= heap IntList(sites.count());
            int32 k = 0;
            while (k < sites.count()) {
                Site s = sites.get(k);
                String q #= s.qualified();
                if (q.equals(name)) {
                    if (s.getKind().isBranch()) {
                        branchArms = branchArms + 1;
                    } else if (s.getKind() == SiteKind.LINE) {
                        int32 at = lineNos.indexOf(s.getLine());
                        if (at < 0) {
                            lineNos.add(s.getLine());
                            if (profile.covered(s.getId())) { lineHit.add(1); }
                            else { lineHit.add(0); }
                        } else if (profile.covered(s.getId())) {
                            lineHit.set(at, 1);
                        }
                    }
                }
                k = k + 1;
            }
            int64 linesTotal = (int64) lineNos.count();
            int64 linesHit = 0;
            int32 h = 0;
            while (h < lineHit.count()) {
                if (lineHit.get(h) > 0) { linesHit = linesHit + 1; }
                h = h + 1;
            }

            int64 comp = 1 + branchArms / 2;
            int64 cov = 1000;
            if (linesTotal > 0) { cov = (linesHit * 1000) / linesTotal; }
            int64 u = 1000 - cov;
            // comp^2 * u^3 / 1e8 gives tenths; + comp in tenths.
            int64 tenths = (comp * comp * u * u * u) / 100000000 + comp * 10;

            out.insertRanked(name, comp, cov, tenths);
            m = m + 1;
        }
        return #out;
    }

    /** Insert keeping descending score order. */
    void insertRanked(String name, int64 comp, int64 cov, int64 tenths) {
        int32 at = 0;
        while (at < this.scoreTenths.count()
               && this.scoreTenths.get(at) >= tenths) {
            at = at + 1;
        }
        this.methods.insert(at, name.substring(0, name.byteLength()));
        // IntList has no insert; rebuild the tail by shifting via add+set.
        this.complexity.add(0);
        this.covPerMille.add(0);
        this.scoreTenths.add(0);
        int32 j = this.scoreTenths.count() - 1;
        while (j > at) {
            this.complexity.set(j, this.complexity.get(j - 1));
            this.covPerMille.set(j, this.covPerMille.get(j - 1));
            this.scoreTenths.set(j, this.scoreTenths.get(j - 1));
            j = j - 1;
        }
        this.complexity.set(at, comp);
        this.covPerMille.set(at, cov);
        this.scoreTenths.set(at, tenths);
    }
}
