package cajeta.coco.ir;

import cajeta.coco.util.Text;
import cajeta.collection.ArrayList;
import cajeta.lang.String;
import cajeta.lang.StringBuilder;

/**
 * IR-level mutation testing: prove the tests *assert*, not merely execute.
 *
 * Coverage's blind spot is verification — a line can run under a test that
 * checks nothing about it. Mutation closes that: change the program in a
 * small, meaning-altering way; if the suite still passes, the behavior the
 * mutant broke was never actually asserted.
 *
 * ## Operator set: `icmp` predicate swaps
 *
 * v1 mutates integer-comparison predicates only:
 *
 *     sgt<->sge   slt<->sle   ugt<->uge   ult<->ule    (boundary)
 *     eq<->ne                                          (negation)
 *
 * Chosen deliberately over arithmetic mutations: cajeta lowers checked
 * arithmetic through `llvm.*.with.overflow` intrinsics, so an add->sub swap
 * would also have to rewrite intrinsic declarations to keep the module
 * linkable. Predicate swaps touch one token, can never invalidate the module,
 * and are the classic highest-yield class — boundary conditions are where
 * off-by-one tests fail to look.
 *
 * ## Mutants come from the *instrumented* module
 *
 * The probes are behavior-neutral (a counter bump), and mutating the module
 * that is already wired into the build means a mutant is one `llc` plus one
 * relink — the sub-second path. Each site also records the nearest preceding
 * coverage probe id, so the driver can skip mutants in code the suite never
 * executes: an unexecuted mutant cannot be killed, and counting it would
 * corrupt the score with findings the coverage report already makes.
 *
 * ## Site indexing is positional
 *
 * `enumerate` and `apply` walk the module identically; site N in the listing
 * is the Nth icmp in the text. That makes the site list a plain contract with
 * the driver — no ids embedded in the IR, nothing to clean up afterward.
 */
public class Mutator {

    /**
     * List every mutation site in `llText`, one TSV row per site:
     *
     *     <index>\t<srcLine>\t<probeId>\t<from>\t<to>\t<method>
     *
     * `srcLine` is the nearest preceding `__cajeta_line_mark`, `probeId` the
     * nearest preceding coverage probe (-1 when none), `method` the enclosing
     * function's mangled symbol.
     */
    public static #String enumerate(String llText) {
        ArrayList<String> lines #= Text.splitLines(llText);
        StringBuilder outSb #= heap StringBuilder();

        int64 idx = 0;
        int64 srcLine = 0;
        int64 probeId = -1;
        String method #= "";

        int32 i = 0;
        while (i < lines.count()) {
            String line = lines.get(i);
            if (line.startsWith("define ")) {
                method #= Mutator.symbolOf(line);
                srcLine = 0;
                probeId = -1;
            } else if (Text.containsFrom(line, "@__cajeta_line_mark(i32 ", 0)) {
                srcLine = Text.intAfter(line, "@__cajeta_line_mark(i32 ");
            } else if (Text.containsFrom(line, "Probe::hit(id:int64)\"(i64 ", 0)) {
                probeId = Text.intAfter(line, "\"(i64 ");
            } else if (Mutator.isMutableCmp(line)) {
                String from #= Mutator.predicateOf(line);
                String to #= Mutator.swapOf(from);
                // Sites inside synthesized functions (reflect_invoke, class
                // registration, drops — anything without a mangled `@"..."`
                // symbol) still consume an index so `apply` stays positional,
                // but are never listed: no test meaningfully targets compiler-
                // generated dispatch code, so a surviving mutant there is
                // noise, not a finding.
                if (to.byteLength() > 0 && method.byteLength() > 0) {
                    outSb.append(Text.fromInt(idx));
                    outSb.append("\t");
                    outSb.append(Text.fromInt(srcLine));
                    outSb.append("\t");
                    outSb.append(Text.fromInt(probeId));
                    outSb.append("\t");
                    outSb.append(from);
                    outSb.append("\t");
                    outSb.append(to);
                    outSb.append("\t");
                    outSb.append(method);
                    outSb.append("\n");
                }
                idx = idx + 1;
            }
            i = i + 1;
        }
        return outSb.toString();
    }

    /**
     * Apply the mutation at positional site `target`, returning the mutated
     * module text. Sites without a defined swap still consume an index (the
     * walk must match `enumerate` exactly), but requesting one yields the
     * module unchanged — the driver never asks for them because `enumerate`
     * never listed them.
     */
    public static #String apply(String llText, int64 target) {
        ArrayList<String> lines #= Text.splitLines(llText);
        ArrayList<String> out #= heap ArrayList<String>();

        int64 idx = 0;
        int32 i = 0;
        while (i < lines.count()) {
            String line = lines.get(i);
            if (Mutator.isMutableCmp(line)) {
                if (idx == target) {
                    String from #= Mutator.predicateOf(line);
                    String to #= Mutator.swapOf(from);
                    if (to.byteLength() > 0) {
                        out.add(Mutator.swapPredicate(line, from, to));
                    } else {
                        out.add(line.substring(0, line.byteLength()));
                    }
                } else {
                    out.add(line.substring(0, line.byteLength()));
                }
                idx = idx + 1;
            } else {
                out.add(line.substring(0, line.byteLength()));
            }
            i = i + 1;
        }
        return Text.joinLines(out);
    }

    /** An integer compare we know how to mutate. */
    static boolean isMutableCmp(String line) {
        return Text.containsFrom(line, " = icmp ", 0);
    }

    /** The predicate token following `icmp `. */
    static #String predicateOf(String line) {
        int64 at = Text.indexOfFrom(line, " = icmp ", 0);
        if (at < 0) { return ""; }
        int64 s = at + 8;
        int64 e = Text.indexOfFrom(line, " ", s);
        if (e < 0) { return ""; }
        return line.substring((int32) s, (int32) e);
    }

    /**
     * The paired mutation for a predicate; empty when the predicate has no
     * defined swap (float predicates arrive via fcmp and never reach here).
     */
    static #String swapOf(String pred) {
        if (pred.equals("sgt")) { return "sge"; }
        if (pred.equals("sge")) { return "sgt"; }
        if (pred.equals("slt")) { return "sle"; }
        if (pred.equals("sle")) { return "slt"; }
        if (pred.equals("ugt")) { return "uge"; }
        if (pred.equals("uge")) { return "ugt"; }
        if (pred.equals("ult")) { return "ule"; }
        if (pred.equals("ule")) { return "ult"; }
        if (pred.equals("eq"))  { return "ne"; }
        if (pred.equals("ne"))  { return "eq"; }
        return "";
    }

    /** Replace the first `icmp <from> ` with `icmp <to> ` on this line. */
    static #String swapPredicate(String line, String from, String to) {
        StringBuilder pat = stack StringBuilder();
        pat.append(" = icmp ");
        pat.append(from);
        pat.append(" ");
        StringBuilder rep = stack StringBuilder();
        rep.append(" = icmp ");
        rep.append(to);
        rep.append(" ");
        String p #= pat.toString();
        String r #= rep.toString();
        return line.replace(p, r);
    }

    /** `define ... @"pkg.Class::method(sig)"(...)` -> the quoted symbol. */
    static #String symbolOf(String line) {
        return Text.between(line, "@\"", "\"", 0);
    }
}
