package cajeta.coco.plugin;

import cajeta.buildtool.plugin.ActionResult;
import cajeta.buildtool.plugin.Finding;
import cajeta.buildtool.plugin.StdoutActionContext;
import cajeta.codec.json.JsonReader;
import cajeta.coco.analysis.CallGraph;
import cajeta.coco.analysis.Crap;
import cajeta.coco.analysis.Coverage;
import cajeta.coco.analysis.FileStats;
import cajeta.coco.model.HitProfile;
import cajeta.coco.model.Site;
import cajeta.coco.model.SiteKind;
import cajeta.coco.model.SiteTable;
import cajeta.coco.report.Html;
import cajeta.coco.report.Lcov;
import cajeta.coco.report.Sarif;
import cajeta.coco.util.Io;
import cajeta.coco.util.Text;
import cajeta.collection.ArrayList;
import cajeta.io.file.FileReader;
import cajeta.lang.String;
import cajeta.lang.StringBuilder;
import cajeta.lang.System;
import cajeta.process.Command;
import cajeta.process.ProcessResult;

/**
 * The build-tool plugin protocol host — what makes coco a JaCoCo-style
 * manifest-declared plugin instead of a hand-run tool.
 *
 * The build tool resolves `plugins.cajeta.coverage` from a repository,
 * spawns the binary its sidecar names, writes ONE JSON request on stdin
 * (action, params — the consumer's config block merged under the task's
 * explicit params — and context.workdir), and reads JSON-line records
 * back: log / output / finding / result. This class speaks that protocol
 * (PluginRuntime.cpp is the canonical spec) and maps two actions onto
 * coco:
 *
 *   cajeta.coverage.instrument — the whole measured pipeline: compile,
 *       instrument, link, run the suite, merge profiles, attribution.
 *       Delegated to `bin/coco run` as a subprocess: the orchestration
 *       already exists there, and a subprocess plugin's entire reason to
 *       exist is that it may spawn things. Fails the task when the suite
 *       fails.
 *
 *   cajeta.coverage.mutate — mutation testing over a completed run:
 *       every instrumented module's icmp predicates swapped one at a time,
 *       relinked from the recorded link line and re-run. Answers what
 *       coverage cannot — whether anything ASSERTED on a line that ran.
 *
 *   cajeta.coverage.report — in-process render (this binary IS the
 *       report engine): HTML + lcov + SARIF from the run's artifacts,
 *       then the `min` gate — below-threshold line coverage returns a
 *       logical error, which fails the build. That is the JaCoCo
 *       `check` semantic.
 *
 * Params (config block or per-action): src, entry, classpath, profile,
 * exclude[], out (default build/coco), coco-home (checkout holding
 * bin/coco), min (percent gate, report only), min-score (mutation-score
 * gate, mutate only). `classpath` falls back to context.classpath — the
 * consumer's resolved dependency archives, which the build tool now sends —
 * so a task no longer has to hand-write archive paths.
 */
public class PluginHost {

    /** Entry: read the request, dispatch, always end with a result line. */
    public static void serve() {
        int8[] req #= PluginHost.readAllStdin();
        int64 n = req.count();
        if (n == 0) {
            PluginHost.resultError("empty request on stdin");
            return;
        }

        Request r #= Request.parse(req, n);

        if (r.action.equals("cajeta.coverage.instrument")) {
            PluginHost.instrument(r);
        } else if (r.action.equals("cajeta.coverage.report")) {
            PluginHost.report(r);
        } else if (r.action.equals("cajeta.coverage.mutate")) {
            PluginHost.mutate(r);
        } else {
            PluginHost.resultError("unknown action: " + r.action);
        }
    }

    // ── instrument ─────────────────────────────────────────────

    static void instrument(Request r) {
        if (r.src.byteLength() == 0 || r.entry.byteLength() == 0) {
            PluginHost.resultError("instrument: config must set 'src' and 'entry'");
            return;
        }
        // The pipeline runs fully in-engine (Pipeline): toolchain paths come
        // from the request context, the probe runtime from the plugin's own
        // dependency archive. `coco-home` is accepted but ignored — the
        // checkout-delegation era is over.
        if (Pipeline.run(r)) {
            PluginHost.resultOk();
        }
    }

    // ── mutate ─────────────────────────────────────────────────

    static void mutate(Request r) {
        if (Mutate.run(r)) {
            PluginHost.resultOk();
        }
    }

    // ── report ─────────────────────────────────────────────────

    static void report(Request r) {
        // `warn` below `min` is configuration nonsense: the warning could
        // never fire without the error firing too, so the level a reader set
        // to see drift EARLY would never be reached. Rejected rather than
        // silently accepted — a config that quietly does nothing is the kind
        // of thing someone only discovers after the drift they set it to
        // catch has already happened.
        if (r.warn > 0 && r.min > 0 && r.warn < r.min) {
            PluginHost.resultError("coverage `warn` (" + Text.fromInt(r.warn)
                + "%) is below `min` (" + Text.fromInt(r.min)
                + "%): a warning below the failing floor can never fire");
            return;
        }

        String base #= r.workdir + "/" + r.out;
        String sitesText #= Io.readAll(base + "/sites.tsv");
        if (sitesText.byteLength() == 0) {
            PluginHost.resultError("report: no sites at " + base
                                   + "/sites.tsv (did instrument run?)");
            return;
        }
        ArrayList<Site> sites #= SiteTable.decode(sitesText);

        // Prefer the attribution-merged profile when present.
        String profText #= Io.readAll(base + "/run/coco.merged.profile");
        if (profText.byteLength() == 0) {
            profText #= Io.readAll(base + "/run/coco.profile");
        }
        HitProfile profile #= HitProfile.decode(profText, "all");

        CallGraph graph = null;
        ArrayList<String> reachable #= heap ArrayList<String>();
        if (r.entry.byteLength() > 0) {
            // owner::method from pkg.Class.method
            int32 lastDot = PluginHost.lastDot(r.entry);
            if (lastDot > 0) {
                String eOwner #= r.entry.substring(0, lastDot);
                String eName #= r.entry.substring(lastDot + 1, r.entry.byteLength());
                CallGraph g #= CallGraph.parseFile(base + "/xref.json");
                ArrayList<String> executed #= heap ArrayList<String>();
                int32 si = 0;
                while (si < sites.count()) {
                    Site st = sites.get(si);
                    if (st.getKind() == SiteKind.FUNCTION
                        && profile.covered(st.getId())) {
                        executed.add(CallGraph.keyOf(st.getOwner(), st.getMethod()));
                    }
                    si = si + 1;
                }
                ArrayList<String> rr #= g.reachableFrom(eOwner, eName, executed);
                if (g.edgeCount() > 0 && rr.count() > 0) {
                    reachable #= rr;
                    graph #= g;
                }
            }
        }

        ArrayList<FileStats> stats #= Coverage.summarize(sites, profile);
        String html #= Html.render(sites, profile, stats, graph, reachable);
        Io.writeAll(base + "/coverage.html", html);
        String lcov #= Lcov.render(sites, profile);
        Io.writeAll(base + "/lcov.info", lcov);
        String sarif #= Sarif.render(sites, profile, stats, graph, reachable);
        Io.writeAll(base + "/coverage.sarif", sarif);
        // The same ranking the HTML shows, as data. A report is not an
        // interface, and the IntelliJ plugin must not re-derive the score in
        // another language — one metric, one definition.
        Crap ranked #= Crap.rank(sites, profile);
        Io.writeAll(base + "/crap.tsv", ranked.encode());

        int64 lc = Coverage.totalLinesCovered(stats);
        int64 lt = Coverage.totalLines(stats);
        String pct #= Text.percent(lc, lt);
        PluginHost.log("coverage: " + pct + "% lines ("
                       + Text.fromInt(lc) + "/" + Text.fromInt(lt) + ")");
        PluginHost.output("percent", pct);
        PluginHost.output("html-path", r.out + "/coverage.html");
        PluginHost.output("lcov-path", r.out + "/lcov.info");
        PluginHost.output("sarif-path", r.out + "/coverage.sarif");

        // ── the gate ───────────────────────────────────────────
        //
        // Severity-bearing FINDINGS rather than a bespoke mechanism (spec
        // §7.1). The number lands in the diagnostic stream, where a CI
        // consumer reads it directly instead of inferring it from an exit
        // code, and an `error` finding fails the task by the general rule
        // (§7a) rather than by coco having its own.
        //
        // JaCoCo-check semantics kept: integer compare against the integer
        // part, so 79.9% fails a min of 80.
        int64 gate = 0;
        if (lt > 0) { gate = (lc * 100) / lt; }

        if (r.min > 0 && gate < r.min) {
            String below #= "coverage " + pct + "% is below min "
                            + Text.fromInt(r.min) + "%";
            // `#below` surrenders the message to the finding, which then
            // owns it; the result reads it back as a borrow rather than
            // building the same sentence twice.
            Finding f #= Finding.error("coverage-min", "", 0, 0, #below);
            PluginHost.finding(f);
            // AND a failing result, deliberately, which spec §7.1's "one
            // mechanism instead of two" does not ask for.
            //
            // The finding alone fails the task only on a build tool that has
            // §7a. Published coco runs on whatever toolchain a consumer has,
            // and dropping the failing result would mean a coverage floor
            // that silently stops being enforced the moment someone upgrades
            // coco without upgrading cajeta — a gate that quietly passes is
            // worse than no gate. The result is the compatibility mechanism,
            // not a second gate: on a new build tool the result is checked
            // first and reports exactly what it always did.
            PluginHost.resultError(f.message());
            return;
        }

        if (r.warn > 0 && gate < r.warn) {
            // Recorded, and the task SUCCEEDS. This is the level that makes a
            // ratchet workable: a project sees drift while it is still cheap
            // to fix, instead of discovering it the day the build breaks.
            String drift #= "coverage " + pct + "% is below warn "
                            + Text.fromInt(r.warn) + "%";
            Finding w #= Finding.warning("coverage-warn", "", 0, 0, #drift);
            PluginHost.finding(w);
        }

        PluginHost.resultOk();
    }

    static int32 lastDot(String s) {
        int32 at = -1;
        int32 i = 0;
        while (i < s.byteLength()) {
            if (s.byteAt(i) == 46) { at = i; }
            i = i + 1;
        }
        return at;
    }

    // ── protocol plumbing ──────────────────────────────────────

    /** Read stdin to EOF. Pipes deliver in chunks; loop until zero. */
    static #int8[] readAllStdin() {
        FileReader r = heap FileReader(0);
        int32 cap = 65536;
        int8[] buf #= heap int8[cap];
        int32 len = 0;
        int8[] chunk #= heap int8[16384];
        int32 got = r.read(chunk, 16384);
        while (got > 0) {
            if (len + got > cap) {
                int32 next = cap * 2;
                while (next < len + got) { next = next * 2; }
                int8[] bigger #= heap int8[next];
                int32 i = 0;
                while (i < len) {
                    bigger[i] = buf[i];
                    i = i + 1;
                }
                buf #= bigger;
                cap = next;
            }
            int32 i = 0;
            while (i < got) {
                buf[len + i] = chunk[i];
                i = i + 1;
            }
            len = len + got;
            got = r.read(chunk, 16384);
        }
        int8[] exact #= heap int8[len];
        int32 i = 0;
        while (i < len) {
            exact[i] = buf[i];
            i = i + 1;
        }
        return #exact;
    }

    static #String bytesToString(int8[] borrowed, int32 n) {
        int8[] copy #= heap int8[n];
        int32 i = 0;
        while (i < n) {
            copy[i] = borrowed[i];
            i = i + 1;
        }
        return heap String(#copy, n);
    }

    /** Forward the driver's `coco:` transcript lines as protocol logs. */
    static void forwardCocoLog(String transcript) {
        ArrayList<String> lines #= Text.splitLines(transcript);
        int32 i = 0;
        while (i < lines.count()) {
            String l = lines.get(i);
            if (l.startsWith("coco:") || l.startsWith("Tests:")) {
                PluginHost.log(l);
            }
            i = i + 1;
        }
    }

    // ── the channel ────────────────────────────────────────────
    //
    // Every record goes through the SHIPPED emitter
    // (`cajeta.buildtool.plugin`), which arrived with the build tool and
    // escapes through `JsonWriter`. coco used to spell each record itself:
    //
    //     System.stdout.println("{\"kind\":\"log\",...,\"message\":\""
    //                           + Text.jsonEscape(message) + "\"}");
    //
    // Two escapers for one wire format is one escaper too many. `jsonEscape`
    // is coco's own and has to be right forever; the shipped one is the
    // build tool's, is tested against the reader that consumes it, and gets
    // fixed once for every plugin when it is wrong.
    //
    // Typed CONCRETELY, not as `ActionContext`. A static field of interface
    // type null-derefs on assignment — measured 2026-08-28 with a two-line
    // probe, SIGSEGV at fault addr (nil), while the identical field typed as
    // the concrete class works. If that compiler defect is fixed, this can
    // become `ActionContext` and gain a recording variant for tests.
    //
    // Process-scoped rather than injected: this binary serves exactly one
    // action per invocation, so the process IS the scope. The shipped API
    // takes an injected context because it must be testable in-process; coco
    // has 54 emit sites and one channel, and threading it would buy nothing
    // here.
    static StdoutActionContext channel;

    static StdoutActionContext out() {
        if (PluginHost.channel == null) {
            PluginHost.channel = heap StdoutActionContext("", "coco", "");
        }
        return PluginHost.channel;
    }

    static void log(String message) {
        PluginHost.out().log(message);
    }

    static void output(String key, String value) {
        PluginHost.out().output(key, value);
    }

    /** An unlocated finding: coco's gates are whole-project metrics. */
    static void finding(Finding f) {
        PluginHost.out().finding(f);
    }

    static void resultOk() {
        ActionResult r #= heap ActionResult();
        PluginHost.out().result(r);
    }

    /**
     * `r.fail(m); result(r)` and NOT `result(r.fail(m))` — the fluent form
     * returns a borrow of the receiver and crashes where a title is wanted.
     * See `ActionResult`'s own docstring, which used to recommend it.
     */
    static void resultError(String message) {
        ActionResult r #= heap ActionResult();
        // `fail` stores the message in a field, so it wants a TITLE — and a
        // borrowed parameter holds none to surrender (the compiler says so in
        // exactly those words). Concatenation materialises one this frame
        // owns, which is then transferred. Declaring `#String message` here
        // instead would push the same problem onto six call sites.
        String owned #= message + "";
        r.fail(#owned);
        PluginHost.out().result(r);
    }
}
