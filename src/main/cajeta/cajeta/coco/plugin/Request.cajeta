package cajeta.coco.plugin;

import cajeta.codec.json.JsonReader;
import cajeta.collection.ArrayList;
import cajeta.lang.String;

/**
 * The parsed plugin request — the single JSON object the build tool writes
 * on stdin (PluginRuntime.cpp's protocol v1).
 *
 * Only what coco's actions consume is captured; everything else flows
 * through the depth accounting untouched. Field capture is SECTION-scoped
 * because the protocol's top level has its own `entry` key (the sidecar
 * symbol path) that must not collide with `params.entry` (the measured
 * program's test entry point).
 */
public class Request {
    /** Top-level action name. */
    String action;
    /** context.workdir — the consumer project's root. */
    String workdir;

    // params (the consumer's config block merged under task params).
    String src;
    String entry;
    String classpath;
    String profile;
    String out;
    String cocoHome;
    int64 min;
    /** `min-score` — the mutation-score gate, mirroring `min` for coverage. */
    int64 minScore;
    ArrayList<String> excludes;

    // context.toolchain — the build tool's own paths, so orchestration
    // needs no machine configuration.
    /**
     * context.classpath — the CONSUMER's resolved dependency archives.
     *
     * Distinct from `classpath` above, which is what the task explicitly
     * passed. The build tool now sends the same comma-joined string it gives
     * the compiler as `--classpath`, so a plugin that compiles the consumer's
     * sources no longer needs the archive paths hand-written into the task.
     * `params.classpath` still wins when set: an explicit answer beats a
     * derived one.
     */
    String contextClasspath;

    String cajetaBin;
    String llcBin;
    String llvmDisBin;
    String ccBin;
    // context.plugin — where this plugin's archive and its dependency
    // closure landed, so bundled bitcode (the probe runtime) can be
    // extracted from the packages it shipped in.
    String pluginArtifact;
    ArrayList<String> pluginDeps;

    Request() {
        this.action #= "";
        this.workdir #= ".";
        this.src #= "";
        this.entry #= "";
        this.classpath #= "";
        this.profile #= "";
        this.out #= "build/coco";
        this.cocoHome #= "";
        this.contextClasspath #= "";
        this.min = 0;
        this.minScore = 0;
        this.excludes #= heap ArrayList<String>();
        this.cajetaBin #= "cajeta";
        this.llcBin #= "llc";
        this.llvmDisBin #= "llvm-dis";
        this.ccBin #= "cc";
        this.pluginArtifact #= "";
        this.pluginDeps #= heap ArrayList<String>();
    }

    public static #Request parse(int8[] buf, int64 n) {
        Request r #= heap Request();
        JsonReader jr = stack JsonReader(buf, n);

        // Sections: 0 top level, 1 params, 2 context. `sub` narrows within
        // context: 1 = toolchain, 2 = plugin. `inExclude` / `inDeps` gate
        // the two string arrays.
        int32 depth = 0;
        int32 section = 0;
        int32 sub = 0;
        int32 field = 0;
        boolean inExclude = false;
        boolean inDeps = false;

        int32 t = (int32) jr.next();
        while (t != 9) {
            if (t == 0 || t == 2) {                       // { or [
                depth = depth + 1;
            } else if (t == 1 || t == 3) {                // } or ]
                depth = depth - 1;
                if (t == 3) { inExclude = false; inDeps = false; }
                if (depth == 2) { sub = 0; }
                if (depth == 1) { section = 0; sub = 0; }
            } else if (t == 4) {                          // KEY
                String name #= jr.currentString();
                if (depth == 1) {
                    if (name.equals("action")) { field = 1; }
                    else if (name.equals("params")) { section = 1; field = 0; }
                    else if (name.equals("context")) { section = 2; field = 0; }
                    else { field = 0; }
                } else if (depth == 2 && section == 1) {
                    if (name.equals("src")) { field = 2; }
                    else if (name.equals("entry")) { field = 3; }
                    else if (name.equals("classpath")) { field = 4; }
                    else if (name.equals("profile")) { field = 5; }
                    else if (name.equals("out")) { field = 6; }
                    else if (name.equals("coco-home")) { field = 7; }
                    else if (name.equals("min")) { field = 8; }
                    else if (name.equals("min-score")) { field = 16; }
                    else if (name.equals("exclude")) { inExclude = true; field = 0; }
                    else { field = 0; }
                } else if (depth == 2 && section == 2) {
                    if (name.equals("workdir")) { field = 9; }
                    else if (name.equals("classpath")) { field = 15; }
                    else if (name.equals("toolchain")) { sub = 1; field = 0; }
                    else if (name.equals("plugin")) { sub = 2; field = 0; }
                    else { field = 0; }
                } else if (depth == 3 && section == 2 && sub == 1) {
                    if (name.equals("cajeta")) { field = 10; }
                    else if (name.equals("llc")) { field = 11; }
                    else if (name.equals("llvm-dis")) { field = 12; }
                    else if (name.equals("cc")) { field = 13; }
                    else { field = 0; }
                } else if (depth == 3 && section == 2 && sub == 2) {
                    if (name.equals("artifact")) { field = 14; }
                    else if (name.equals("deps")) { inDeps = true; field = 0; }
                    else { field = 0; }
                } else {
                    field = 0;
                }
            } else if (t == 5) {                          // STRING
                if (inExclude && depth == 3 && section == 1) {
                    r.excludes.add(jr.currentString());
                } else if (inDeps && depth == 4 && section == 2) {
                    r.pluginDeps.add(jr.currentString());
                } else if (field == 1) { r.action #= jr.currentString(); }
                else if (field == 2) { r.src #= jr.currentString(); }
                else if (field == 3) { r.entry #= jr.currentString(); }
                else if (field == 4) { r.classpath #= jr.currentString(); }
                else if (field == 5) { r.profile #= jr.currentString(); }
                else if (field == 6) { r.out #= jr.currentString(); }
                else if (field == 7) { r.cocoHome #= jr.currentString(); }
                else if (field == 9) { r.workdir #= jr.currentString(); }
                else if (field == 10) { r.cajetaBin #= jr.currentString(); }
                else if (field == 11) { r.llcBin #= jr.currentString(); }
                else if (field == 12) { r.llvmDisBin #= jr.currentString(); }
                else if (field == 13) { r.ccBin #= jr.currentString(); }
                else if (field == 14) { r.pluginArtifact #= jr.currentString(); }
                else if (field == 15) { r.contextClasspath #= jr.currentString(); }
                field = 0;
            } else if (t == 6) {                          // NUMBER
                if (field == 8) { r.min = jr.currentNumberAsInt64(); }
                else if (field == 16) { r.minScore = jr.currentNumberAsInt64(); }
                field = 0;
            } else {
                field = 0;
            }
            t = (int32) jr.next();
        }
        // An explicit params.classpath wins; otherwise inherit the consumer's
        // resolved one. Folding it in HERE rather than at each use keeps every
        // consumer of `r.classpath` — addFlags, classpathObjects, archiveWith
        // — unchanged and unable to disagree about which one applies.
        if (r.classpath.byteLength() == 0) {
            r.classpath #= r.contextClasspath.substring(
                0, r.contextClasspath.byteLength());
        }
        return #r;
    }
}
